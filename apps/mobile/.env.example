# Copy to .env.local for development. Both values are public client credentials; never put a
# service-role key here. Released builds read the same two values from release.config.json.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# owner/repo whose GitHub Releases carry the APK. The app downloads updates only from here.
EXPO_PUBLIC_GITHUB_REPO=ggumtak/dayframe
